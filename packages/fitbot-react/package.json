{
    "name": "@fitbot/react",
    "version": "0.0.1",
    "description": "The official React component for FitBot",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.tsx --format cjs,esm --dts",
        "lint": "eslint src --ext .ts,.tsx",
